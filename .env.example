# Copy to .env.local and fill in. Never commit .env.local.
NEXT_PUBLIC_SITE_URL=https://www.avvvs.com

# Shopify Storefront API (Settings → Apps → Develop apps → Storefront API)
SHOPIFY_STORE_DOMAIN=avvvsglobal.myshopify.com
SHOPIFY_STOREFRONT_TOKEN=
SHOPIFY_API_VERSION=2026-10

# Booking email over the clinic's SMTP mailbox
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM="AVVVS Clinic <mail@avvvs.com>"
BOOKING_TO=mail@avvvs.com
